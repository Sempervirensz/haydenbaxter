# Copy to .env.local for local development. Never commit real values.
# (.env / .env.* are gitignored; this .example file is the tracked template.)

# Canonical production origin used for metadata, canonical URLs, sitemap,
# robots, JSON-LD, and OpenGraph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.haydenbaxter.com

# Optional: ISO 8601 timestamp after which the private /happybirthdaykemmerlee
# page stops rendering. Leave unset to keep it always available.
# BIRTHDAY_PAGE_EXPIRES_AT=2026-01-01T00:00:00Z
