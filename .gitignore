.next/
# Every NEXT_DIST_DIR build dir, not an enumeration of the ones that existed
# when this line was written. Each concurrent dev server needs its own
# (see the `next-dev-*` entries in .claude/launch.json), so the list grows
# whenever another agent session starts one — and `vercel --prod` uploads the
# WORKING TREE, so a dist dir nobody remembered to list here is ~100MB pushed
# to production. `.next-motion/` and `.next-wp/` were both missing when this
# was generalised.
.next-*/
node_modules/
out/
.DS_Store
*.tsbuildinfo
next-env.d.ts
.vercel

# Agent working state — per-machine and disposable. .claude/worktrees holds
# real git worktrees, which must never be committed into the repo itself.
.claude/settings.local.json
.claude/plans/
.claude/worktrees/

# Camera originals for the About collage. Byte-identical to the tracked
# public/about/* source files, which are themselves only kept as the source
# for the WebP the site actually serves. Nothing references these.
public/Personal Photos/

# Environment files — never commit real secrets. .env.example IS tracked.
.env
.env.*
!.env.example

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Static sub-apps kept for reference. Out of public/ so Next stops copying
# them into the deployed build (ETB-P1-04b); still here if ever needed.
archive/
