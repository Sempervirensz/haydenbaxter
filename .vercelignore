# Deploys go out with `vercel --prod`, which uploads the WORKING TREE rather
# than a git ref. Without this file the sibling dev dist dirs went with it and
# broke the production build:
#
#   .next-motion/types/validator.ts:25
#   Type error: Type '"/admin"' is not assignable to type '"/"'.
#
# Those dirs come from the NEXT_DIST_DIR escape hatch in next.config.ts, so each
# chat can run its own dev server without two `next dev` fighting over `.next`
# (see .claude/launch.json). A dev server registers `.dev.tsx` routes, so the
# types Next generates in them describe /admin and every lab. Production's
# pageExtensions has no `.dev.tsx`, those routes do not exist, and the stale
# validator no longer typechecks against the real route set.
#
# `.gitignore` already covers them at `.next-*`, which is why they never showed
# up in `git status` — and why this was invisible until a deploy failed.
.next
.next-*

# Local performance lab — ~16MB of PNG filmstrips and run JSON that no route
# imports. `.gitignore` covers it too, but this file is what governs the upload.
experiments/

# Agent worktrees. `.claude/worktrees/` holds a FULL checkout per session — ten
# of them were 7.1GB of the working tree's 9.3GB, and since the upload is the
# working tree rather than a git ref, every one of them was being sent to
# Vercel. That is what it looks like from the outside:
#
#   Uploading [===============-----] (1.5GB/2GB)
#   Error: FetchError: ... reason: write EPIPE
#   Error: AbortError: The user aborted a request.
#
# Nothing under `.claude/` is read by the build, and each worktree carries its
# own `.next*` and `out/` besides. Excluding the directory takes the upload from
# ~9.3GB to roughly 1GB.
.claude/worktrees/

# Regenerated by the remote build; uploading the local copy is ~157MB of waste.
out/
